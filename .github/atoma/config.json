{
  "version": 2,
  "dispatch": {
    "workflow": "atoma-runner.yml"
  },
  "agents": {
    "orchestrator": {
      "max_iterations": 50,
      "shared_context": {
        "include_event_types": [
          "issue_opened",
          "issue_comment",
          "linked_issue_opened",
          "linked_issue_comment",
          "pr_opened",
          "pr_comment",
          "pr_review",
          "pr_review_comment",
          "pr_diff"
        ]
      }
    },
    "engineer": {
      "max_iterations": 30,
      "shared_context": {
        "include_event_types": [
          "issue_opened",
          "issue_comment",
          "linked_issue_opened",
          "linked_issue_comment",
          "pr_opened",
          "pr_comment",
          "pr_review",
          "pr_review_comment",
          "pr_diff"
        ]
      }
    },
    "reviewer": {
      "max_iterations": 20,
      "max_review_loops": 5,
      "shared_context": {
        "include_event_types": [
          "pr_opened",
          "pr_comment",
          "pr_review",
          "pr_review_comment",
          "pr_diff",
          "linked_issue_opened",
          "linked_issue_comment"
        ]
      }
    }
  },
  "auto_triggers": [
    {
      "event": "pull_request.opened",
      "agent": "reviewer"
    },
    {
      "event": "pull_request.synchronize",
      "agent": "reviewer"
    },
    {
      "event": "pull_request.ready_for_review",
      "agent": "reviewer"
    },
    {
      "event": "pull_request_review.submitted",
      "agent": "engineer",
      "condition": "changes_requested"
    },
    {
      "event": "issue_comment.created",
      "agent": "$dispatch_agent",
      "condition": "atoma:dispatch"
    }
  ]
}
