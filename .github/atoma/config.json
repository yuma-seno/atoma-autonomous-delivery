{
  "version": 3,
  "agents": {
    "orchestrator": {
      "model": "deepseek/deepseek-v4-flash",
      "max_iterations": 100
    },
    "engineer": {
      "model": "deepseek/deepseek-v4-flash",
      "max_iterations": 50
    },
    "reviewer": {
      "model": "deepseek/deepseek-v4-flash",
      "max_iterations": 30,
      "max_review_loops": 5,
      "merge_policy": "manual"
    }
  },
  "labels": {
    "in_progress": "atoma/in-progress",
    "sub_issue": "atoma/sub-issue"
  },
  "auto_triggers": [
    {
      "event": "pull_request.opened",
      "agent": "reviewer"
    },
    {
      "event": "pull_request.synchronize",
      "agent": "reviewer"
    },
    {
      "event": "pull_request.ready_for_review",
      "agent": "reviewer"
    },
    {
      "event": "pull_request_review.submitted",
      "agent": "engineer",
      "condition": "changes_requested"
    },
    {
      "event": "issue_comment.created",
      "agent": "$dispatch_agent",
      "condition": "atoma:dispatch"
    }
  ]
}
