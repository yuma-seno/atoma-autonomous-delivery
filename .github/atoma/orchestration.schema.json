{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuma-seno/atoma/orchestration.schema.json",
  "title": "Atoma GitHub Runtime Config",
  "type": "object",
  "required": ["version", "dispatch", "agents", "scripts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "dispatch": {
      "type": "object",
      "required": ["workflow"],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "properties": {
            "shared_context": {
              "type": "object",
              "properties": {
                "include_event_types": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "exclude_event_types": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scripts": {
      "type": "object",
      "required": ["create_pr", "push_commits", "launch_sub_agent"],
      "properties": {
        "create_pr": {
          "type": "object",
          "required": ["dispatch_agent"],
          "properties": {
            "dispatch_agent": {
              "type": "string",
              "pattern": "^$|^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        },
        "push_commits": {
          "type": "object",
          "required": ["dispatch_agent"],
          "properties": {
            "dispatch_agent": {
              "type": "string",
              "pattern": "^$|^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        },
        "launch_sub_agent": {
          "type": "object",
          "required": ["session_ends", "notify_agent"],
          "properties": {
            "session_ends": {
              "type": "boolean"
            },
            "notify_agent": {
              "type": "string",
              "pattern": "^$|^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
