{
  "name": "atoma-autonomous-delivery",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "synth": "gwf build && bun run src/build-dist.ts",
    "synth:check": "bun run synth && git diff --exit-code -- dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src/scripts ./dist/.github/atoma/tools/scripts/mcp ./dist/.github/atoma/tools/scripts/hooks",
    "lint": "bun run typecheck && bun run synth:check"
  },
  "devDependencies": {
    "@github-actions-workflow-ts/actions": "^2.5.0",
    "@github-actions-workflow-ts/cli": "^2.5.0",
    "@github-actions-workflow-ts/lib": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/bun": "^1.2.14",
    "typescript": "^5.6.3"
  }
}
