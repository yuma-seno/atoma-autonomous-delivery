          "id": "call_ec337199aaf84992a2285b4a",
          "type": "function",
          "function": {
            "name": "shell__shell_execute",
            "arguments": "{\"command\": \"echo '=== direct shim test (does the non-setuid map write work?) ==='\\nunshare -U sleep 30 &\\npid=$!\\nsleep 0.3\\n~/.local/bin/newuidmap \\\"$pid\\\" 0 1234 1 1 10000 50000 && echo uidmap-write-ok || echo uidmap-write-FAILED\\n~/.local/bin/newgidmap \\\"$pid\\\" 0 0 1 1 10000 50000 && echo gidmap-write-ok || echo gidmap-write-FAILED\\necho '--- resulting map ---'\\ncat /proc/$pid/uid_map\\ncat /proc/$pid/gid_map\\nkill \\\"$pid\\\" 2>/dev/null; wait \\\"$pid\\\" 2>/dev/null\\necho '=== item 5: dns ==='\\npodman run --rm docker.io/library/alpine:latest sh -c 'nslookup example.com >/dev/null 2>&1 && echo dns-ok' 2>&1\\necho '=== item 6: --user 65534 ==='\\npodman run --rm --user 65534 docker.io/library/alpine:latest id 2>&1\", \"timeout_seconds\": 300, \"working_directory\": \"/home/runner/work/atoma-autonomous-delivery/atoma-autonomous-delivery\"}"
