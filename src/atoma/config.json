{
  "merge_policy": "auto",
  "environment": {
    "setup_commands": []
  },
  "checks": {
    "commands": [],
    "secrets": []
  },
  "deploy": {
    "targets": [],
    "secrets": []
  },
  "tools": {
    "secrets": []
  },
  "agents": {
    "orchestrator": {
      "max_iterations": 100
    },
    "engineer": {
      "max_iterations": 200
    },
    "reviewer": {
      "max_iterations": 30
    }
  },
  "labels": {
    "in_progress": "atoma/in-progress",
    "sub_issue": "atoma/sub-issue",
    "launched": "atoma/launched"
  },
  "auto_triggers": [
    {
      "event": "issue_comment.created",
      "agent": "$dispatch_agent",
      "condition": "atoma:dispatch"
    }
  ]
}
