#!/usr/bin/env bun
/**
 * fake `gh` CLI — a minimal stand-in used only by the E2E test harness
 * (tests/e2e/). This directory is prepended to PATH for the MCP server
 * subprocess under test, so THIS file (not the real `gh`) is what
 * lib/gh.ts's `Bun.spawnSync(["gh", ...])` calls resolve to. It understands
 * just enough invocations to satisfy mcp/github.ts's real business logic
 * without ever touching the real GitHub API. Extend as new E2E scenarios
 * need more `gh` subcommands.
 */

const args = process.argv.slice(2);

if (args[0] === "issue" && args[1] === "view") {
  const number = Number(args[2]);
  console.log(
    JSON.stringify({
      number,
      title: `Fake issue #${number}`,
      body: "This is a fake issue body for E2E testing.",
      state: "OPEN",
      labels: [],
      createdAt: "2026-01-01T00:00:00Z",
      closedAt: null,
      comments: [],
      author: { id: "1", is_bot: false, login: "fake-human", name: "Fake Human" },
    }),
  );
  process.exit(0);
}

console.error(`fake gh: unhandled invocation: gh ${args.join(" ")}`);
process.exit(1);
