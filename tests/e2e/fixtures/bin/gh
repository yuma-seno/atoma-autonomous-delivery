#!/usr/bin/env bun
/**
 * fake `gh` CLI — a minimal stand-in used only by the E2E test harness
 * (tests/e2e/). This directory is prepended to PATH for the atoma binary
 * itself (see run-agent.e2e.test.ts), so every spawned MCP server AND every
 * script THEY spawn in turn (they all inherit env down the chain) resolves
 * `gh` to this file instead of the real CLI.
 *
 * Configurable via env vars (same design as src/scripts/testing/bin/gh):
 *   FAKE_GH_RESPONSES = JSON array of { match: string[]; stdout?: string; code?: number }.
 *     A rule matches when EVERY string in `match` is a substring of at
 *     least one argv element. First matching rule (in array order) wins.
 *   FAKE_GH_LOG = path this appends one JSON line (the full argv array) to
 *     per invocation, so tests can assert on exact commands issued.
 */
const args = process.argv.slice(2);

const logPath = process.env.FAKE_GH_LOG;
if (logPath) {
  const { appendFileSync } = await import("node:fs");
  appendFileSync(logPath, JSON.stringify(args) + "\n");
}

interface Rule {
  match: string[];
  stdout?: string;
  code?: number;
}

const rules: Rule[] = process.env.FAKE_GH_RESPONSES ? JSON.parse(process.env.FAKE_GH_RESPONSES) : [];

function matches(rule: Rule): boolean {
  return rule.match.every((needle) => args.some((a) => a.includes(needle)));
}

const found = rules.find(matches);
if (found) {
  console.log(found.stdout ?? "");
  process.exit(found.code ?? 0);
}

console.error(`fake gh: no matching rule for: gh ${args.join(" ")}`);
process.exit(1);
